#!/usr/bin/env bash

set -e

cd "$(dirname "$0")/.."

if [ "$1" = "--fix" ]; then
  echo "==> Running ruff with --fix"
  uv run ruff check . --fix
else
  echo "==> Running ruff"
  uv run ruff check .
fi

echo "==> Running pyright"
uv run pyright -p .
uv run pyright -p . --pythonversion 3.12

echo "==> Running mypy"
uv run mypy .
uv run mypy . --python-version 3.12

echo "==> Making sure it imports"
uv run python -c 'import browserbase'
